CREATE TABLE IF NOT EXISTS word_learning (
    translation_id INTEGER NOT NULL PRIMARY KEY,
    grade          INTEGER NOT NULL
);

getWordGrade:
SELECT grade FROM word_learning
WHERE translation_id = :translationId;

upsertWordGrade:
INSERT OR REPLACE INTO word_learning (translation_id, grade)
VALUES (:translationId, :grade);

getAllWordLearning:
SELECT translation_id, grade FROM word_learning WHERE grade < 5;
