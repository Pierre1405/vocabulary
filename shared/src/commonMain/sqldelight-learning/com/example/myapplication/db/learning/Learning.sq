CREATE TABLE IF NOT EXISTS learning (
    key             TEXT    NOT NULL,
    source_locale   TEXT    NOT NULL,
    target_locale   TEXT    NOT NULL,
    grade           INTEGER NOT NULL,
    type            TEXT    NOT NULL,
    interval_hours  INTEGER NOT NULL DEFAULT 0,
    next_review     INTEGER NOT NULL DEFAULT 0,
    PRIMARY KEY (key, source_locale, target_locale, type)
);

upsertGrade:
INSERT OR REPLACE INTO learning (key, source_locale, target_locale, grade, type, interval_hours, next_review)
VALUES (:key, :sourceLocale, :targetLocale, :grade, :type, :intervalHours, :nextReview);

getGrade:
SELECT grade, interval_hours FROM learning
WHERE key = :key AND source_locale = :sourceLocale AND target_locale = :targetLocale AND type = :type;

countDue:
SELECT COUNT(*) FROM learning
WHERE source_locale = :sourceLocale AND target_locale = :targetLocale AND type = :type AND next_review <= :now;

getKeysDue:
SELECT key FROM learning
WHERE source_locale = :sourceLocale AND target_locale = :targetLocale AND type = :type AND next_review <= :now;

getGradesByDirection:
SELECT key, grade FROM learning
WHERE source_locale = :sourceLocale AND target_locale = :targetLocale AND type = :type;

getAllDue:
SELECT key, grade FROM learning
WHERE source_locale = :sourceLocale AND target_locale = :targetLocale AND type = :type AND next_review <= :now;

getUpcomingGroups:
SELECT source_locale, target_locale, type, COUNT(*) AS count, MIN(next_review) AS next_review_epoch
FROM learning
WHERE next_review > :now
GROUP BY source_locale, target_locale, type
ORDER BY next_review_epoch ASC;

getUpcomingWordItems:
SELECT key, source_locale, target_locale, next_review
FROM learning
WHERE next_review > :now AND type = 'word'
ORDER BY next_review ASC;

getUpcomingConjugationItems:
SELECT key, grade, next_review
FROM learning
WHERE next_review > :now AND type = 'conjugation' AND source_locale = 'de' AND target_locale = 'de'
ORDER BY next_review ASC;

getLowGradeItems:
SELECT key, grade FROM learning
WHERE source_locale = :sourceLocale AND target_locale = :targetLocale AND type = :type AND grade <= :maxGrade
ORDER BY grade ASC;

deleteGrade:
DELETE FROM learning
WHERE key = :key AND source_locale = :sourceLocale AND target_locale = :targetLocale AND type = :type;

deleteByKeyPrefix:
DELETE FROM learning
WHERE key LIKE :keyPrefix AND type = :type;
